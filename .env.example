# --- Chunk 1 ---
GCP_PROJECT_ID=swiftcare-patchamomma
BQ_LOCATION=US
BQ_DATASET_RAW=swiftcare_fhir_raw
BQ_DATASET_ANALYTICS=swiftcare_fhir_analytics
BQ_DATASET_VIEWS=swiftcare_fhir_views
BQ_DATASET_CACHE=swiftcare_agent_cache
BQ_DATASET_OPS=swiftcare_ops
FHIR_PUBLIC_PROJECT=bigquery-public-data
FHIR_PUBLIC_DATASET=fhir_synthea
COHORT_PATIENT_LIMIT=5000

# --- Chunk 2 ---
GEMINI_MODEL=gemini-2.5-flash
GOOGLE_CLOUD_PROJECT=swiftcare-patchamomma
# Vertex AI (recommended for GCP billing / ADC) — no AI Studio API key needed
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_LOCATION=us-central1
# AI Studio key path (only if GOOGLE_GENAI_USE_VERTEXAI=FALSE):
# GOOGLE_API_KEY=
AGENT_TYPE=retrieval
AGENT_NAME=swiftcare_retrieval_agent
DEFAULT_TIMELINE_LIMIT=50
DEFAULT_VISIT_LIMIT=20
SEARCH_RESULT_LIMIT=20
LOG_QUERIES_TO_BQ=TRUE

# --- Chunk 3 ---
# When running the suggestion agent, set AGENT_TYPE/AGENT_NAME accordingly:
# AGENT_TYPE=suggestion
# AGENT_NAME=swiftcare_suggestion_agent
MAX_CARDS_PER_TURN=5
MAX_VISIT_LOOKBACK=20
POLYPHARMACY_MED_THRESHOLD=5
FOLLOW_UP_GAP_DAYS=180
CARD_DEFAULT_SEVERITY=info
DEDUPE_OPEN_CARDS=TRUE

# --- Chunk 4 ---
# When running the insights agent, set AGENT_TYPE/AGENT_NAME accordingly:
# AGENT_TYPE=insights
# AGENT_NAME=swiftcare_insights_agent
DEFAULT_AT_RISK_LIMIT=50
MAX_ALERTS_PER_TURN=10
DEDUPE_OPEN_ALERTS=TRUE

# --- Chunk 6: FastAPI / Cloud Run ---
API_HOST=0.0.0.0
API_PORT=8080
# Local only — must be false on Cloud Run (see final_chunk_6.md D6)
API_AUTH_BYPASS=true
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
FIREBASE_PROJECT_ID=
# Optional: serve built FE from the API process
STATIC_FE_DIR=frontend/dist
# CLOUD_RUN_SERVICE=swiftcare-api
# CLOUD_RUN_SA=swiftcare-run@PROJECT.iam.gserviceaccount.com
